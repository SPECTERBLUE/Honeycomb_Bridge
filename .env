# Honeycomb Bridge — docker-compose env vars for `api`, `docker-ops-sidecar`, `redis`.
# Gitignored (matches the existing `.env` rule) — do not commit real secrets here.
#
# Values below assume `magistrala-base-net` already exists (bring up
# chirpstack-docker and/or edgex/edgex-go first) and that Magistrala's
# gateway/user-service run on the host, reached via host.docker.internal.

# --- ChirpStack (gRPC + HTTP REST), on magistrala-base-net ---
CHIRPSTACK_HOST=chirpstack:8080
CHIRPSTACK_HTTP_BASE_URL=http://chirpstack-rest-api:8090
# Same token currently hardcoded in config.py — rotate per CONTAINERIZATION.md item 1
# (already committed to git history, treat as compromised).
CHIRPSTACK_API_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJjaGlycHN0YWNrIiwiaXNzIjoiY2hpcnBzdGFjayIsInN1YiI6IjQ2ZjU4ZGI4LWY2MDUtNGI5MC1iYThkLWJkMjI3M2Q4YzIxOSIsInR5cCI6ImtleSJ9.vn5K_yZJ-fTRKQOmiZIQlKoGDFHV5W7NaaagK3PucGE

# --- MQTT broker (mosquitto, on magistrala-base-net) ---
MQTT_BROKER_HOST=mosquitto

# --- Magistrala main gateway / user service (host-run, not in a Compose stack here) ---
BASE_URL=http://host.docker.internal:80
USERS_SERVICE_URL=http://host.docker.internal:9002

# --- EdgeX (on magistrala-base-net) ---
EDGEX_VAULT_BASE_URL=http://edgex-vault:8200
EDGEX_NOTIFICATION_BASE_URL=http://edgex-support-notifications:59860

# --- Encryption keys — rotate per CONTAINERIZATION.md item 1 ---
AES_KEY=n2342dwwendwejnwedwjkdnwedne2dxn
LOGIN_AESGCM_KEY=bR7xZ1qP8eWn4vFVS23KY92MuXqGdEL0

# --- SMTP / alerting ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=mdltest86@gmail.com
SMTP_PASSWORD=bhew gqyo hfrv pqrk

# --- Redis (honeycomb-net, this stack's own instance) ---
REDIS_HOST=redis
REDIS_PORT=6389

# --- docker-ops-sidecar ---
DOCKER_OPS_SIDECAR_URL=http://docker-ops-sidecar:8097
# Must be identical on both `api` and `docker-ops-sidecar` — shared via this one
# env_file so they always match. Generate a fresh one with:
#   openssl rand -hex 32
SIDECAR_SHARED_SECRET=88ae9fb76dca5c71447a0db7037cf3c578ace21e2e57af09ef787a8f6596036f

# Sibling container names docker-ops-sidecar execs into (defaults already match
# config.py's fallbacks — only listed here for visibility).
CONTAINER_EDGEX_SECURITY_PROXY=edgex-security-proxy-setup
CONTAINER_CHIRPSTACK=chirpstack-chirpstack-1
CONTAINER_VAULT=edgex-security-secretstore-setup
VAULT_ROOT_PATH=/vault/config/assets/resp-init.json

# auth-db credentials, JWT settings, and default-admin bootstrap live in
# auth/.env.docker instead — kept next to the rest of the auth module's config
# rather than mixed in with this file's infra vars.

